import ast
import operator
import os
import sqlite3
from pathlib import Path

# Secrets come from environment variables, never from the code.
DB_PASSWORD = os.getenv("DB_PASSWORD")
API_KEY = os.getenv("API_KEY")

REPORT_DIR = Path("reports")

OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
}


def get_user(username):
    """Look up a user. The value is passed as a parameter, so it cannot change the query."""
    conn = sqlite3.connect("users.db")
    try:
        query = "SELECT * FROM users WHERE name = ?"
        return conn.execute(query, (username,)).fetchall()
    finally:
        conn.close()


def is_admin(user):
    """Only users whose role is exactly 'admin' are admins."""
    return isinstance(user, dict) and user.get("role") == "admin"


def average(numbers):
    """Return the average, or None for an empty list."""
    if not numbers:
        return None
    return sum(numbers) / len(numbers)


def last_item(items):
    """Return the last item, or None for an empty list."""
    if not items:
        return None
    return items[-1]


def run_report(filename):
    """Read a report file, but only from inside the reports folder."""
    base = REPORT_DIR.resolve()
    path = (base / filename).resolve()
    if base not in path.parents:
        raise ValueError("Invalid report path")
    return path.read_text()


def calculate(expression):
    """Evaluate simple maths (+ - * /) without running arbitrary code."""

    def walk(node):
        if isinstance(node, ast.Expression):
            return walk(node.body)
        if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in OPERATORS:
            return OPERATORS[type(node.op)](walk(node.left), walk(node.right))
        raise ValueError("Unsupported expression")

    return walk(ast.parse(expression, mode="eval"))
